# База заявок. Локально можно не задавать: по умолчанию файл ./data/leads.db.
# На Vercel обе переменные создаёт интеграция Turso (или задайте вручную).
TURSO_DATABASE_URL=file:./data/leads.db
TURSO_AUTH_TOKEN=

# Соль для хэша IP в ограничении частоты запросов. Любая длинная случайная строка.
RATE_LIMIT_SALT=

# Необязательно: дубль заявок в Telegram. Без них уведомления просто не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
